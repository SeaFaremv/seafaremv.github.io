# Copy this file to .env and fill in real values.
# Never commit the real .env file to GitHub.

# --- Database (required) -----------------------------------------------------
# From your Neon project dashboard -> Connection Details. Use the "pooled
# connection" string if Neon offers both.
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# --- Front-end URL (required for PIN/passkey reset links) -------------------
# Your GitHub Pages URL, used to build the links emailed/texted during a
# reset, e.g. https://YOUR-USERNAME.github.io/YOUR-REPO
APP_URL=https://YOUR-USERNAME.github.io/YOUR-REPO

# --- Data encryption at rest (strongly recommended) --------------------------
# Encrypts shipment photos and bank account details before they're stored --
# each boat/organization gets its own derived key, so this one master value
# never appears in the database itself. Generate a long random value once
# (e.g. `openssl rand -base64 48`) and never change it afterward -- changing
# it makes every previously-encrypted photo and bank field unreadable. If
# left unset, the app still works, but those fields are stored in plain text.
APP_DATA_ENCRYPTION_KEY=

# --- Owner PIN reset via email (optional) ------------------------------------
# A Gmail account the server sends FROM. GMAIL_APP_PASSWORD is an "App
# Password" generated at https://myaccount.google.com/apppasswords -- this
# requires 2-Step Verification to be turned on for that Gmail account first.
# If unset, the reset link is still generated and returned to the app (so the
# Owner can open/share it manually) -- email just won't be auto-sent.
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16characterapppassword

# --- Owner PIN reset via SMS (optional) --------------------------------------
# From your Twilio console (twilio.com/console). TWILIO_PHONE_NUMBER is the
# SMS-capable Twilio number the text is sent FROM. Same fallback as above if
# unset -- the link is still returned to the app either way.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# --- Owner PIN reset via authenticator app (legacy, optional) ---------------
# Each organization gets its own TOTP secret generated automatically at
# signup -- this env var is only a fallback used by very old reset links
# that predate that and no longer get created. Safe to leave unset.
TOTP_SECRET=

# --- Super Admin dashboard (required to use it) ------------------------------
# Credentials for the Super Admin screen (organization/boat management,
# suspend/delete, boat request approvals). Choose your own values -- these
# are not defaults, there is no fallback.
ADMIN_USERNAME=choose_a_username
ADMIN_PASSWORD=choose_a_strong_password

# --- Google Sheets trip logging (optional) -----------------------------------
# Requires a Google Cloud project with the Sheets API and Drive API enabled,
# and an OAuth 2.0 Client ID (console.cloud.google.com -> APIs & Services ->
# Credentials). GOOGLE_REDIRECT_URI must exactly match a redirect URI
# registered on that Client ID, and should point at this API server, e.g.
# https://your-api-host.onrender.com/api/google/oauth-callback
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://your-api-host.onrender.com/api/google/oauth-callback

# --- Swipe payment link (Pro upgrade, optional) ------------------------------
# From the Swipe Merchant Portal (merchant.swipe.mv) -> Settings -> API Access.
# SWIPE_WEBHOOK_SECRET is the "Webhook HMAC Key" shown on that same page --
# also register this server's /api/webhooks/swipe URL there as the webhook
# endpoint. If these are unset, the Pro popup just shows the bank-transfer
# option (the payment-link option won't appear).
SWIPE_CLIENT_ID=
SWIPE_CLIENT_SECRET=
SWIPE_WEBHOOK_SECRET=
# 'production' (default) or 'development' -- which Swipe API environment to use.
SWIPE_ENV=production
# MVR amount charged per 30-day Pro period. Defaults to 500 if unset.
SWIPE_PRO_AMOUNT=500
# This Swipe client/wallet is shared with a second app (Maldexpress) that
# uses it for its own Pro payments. Swipe allows only one webhook URL per
# client, so /api/webhooks/swipe forwards any event whose transaction_code
# starts with "maldexpress_" -- verbatim, after verifying the Swipe
# signature -- to Maldexpress's own handler here, and replies to Swipe with
# that forward's result. Leave unset to disable the relay (all events then
# go to SeaFare's own processing).
MALDEXPRESS_SWIPE_WEBHOOK_URL=https://ngoykqdzjpkrdqwhaqjy.supabase.co/functions/v1/swipe-webhook

# --- RedotPay card payment link (Pro upgrade, optional) ----------------------
# A second, independent "Pay by Card" option alongside Swipe, via RedotPay
# Connect (redotpay.readme.io). Get verified as a merchant on the RedotPay
# Connect platform, then:
#   1. Generate an RSA key pair (recommended 2048-bit), e.g.:
#        openssl genrsa -out redotpay_private_key.pem 2048
#        openssl rsa -in redotpay_private_key.pem -pubout -out redotpay_public_key.pem
#   2. Upload redotpay_public_key.pem in the RedotPay platform's Developer
#      settings -- this is what gives you REDOTPAY_APP_KEY.
#   3. Register this server's /api/webhooks/redotpay URL as the webhook
#      endpoint on the same page.
# If REDOTPAY_APP_KEY/REDOTPAY_PRIVATE_KEY are unset, the Pro popup just
# doesn't show the "Pay by Card" option (Swipe and bank transfer still work).
REDOTPAY_APP_KEY=
# Paste the full PEM block (BEGIN/END PRIVATE KEY lines included), or just
# the base64 body -- either is fine, and literal \n line breaks are handled
# either way. NEVER commit the real value; keep it only in your host's env
# var settings.
REDOTPAY_PRIVATE_KEY=
# Key version of the RSA pair above on RedotPay's side (matches whatever
# X-R-Key-Version you're on after the initial upload -- normally 1).
REDOTPAY_KEY_VERSION=1
# 'production' (default) or 'sandbox' -- which RedotPay API environment to use.
REDOTPAY_ENV=production
# Fiat amount + currency charged per 30-day Pro period via this path. Unlike
# Swipe (MVR), RedotPay settles in a small set of fiat currencies -- set
# these to whatever your RedotPay merchant account actually supports.
REDOTPAY_PRO_AMOUNT=5
REDOTPAY_PRO_CURRENCY=USD

# --- Web Push (Super Admin push notifications, optional) --------------------
# Lets the Super Admin get real OS-level notifications even with the tab
# closed (the "Enable Push Notifications on This Device" button on the
# Notifications tab). This exact keypair was generated for this project --
# the PUBLIC key is already embedded in index.html (ADMIN_PUSH_VAPID_PUBLIC_KEY)
# since it's safe to be public; only the PRIVATE key needs to be set here.
# If you'd rather generate your own pair instead: `npx web-push generate-vapid-keys`
# -- then update ADMIN_PUSH_VAPID_PUBLIC_KEY in index.html to match.
VAPID_PUBLIC_KEY=BOWeAWH_VWxCKgUB1gZDDWgTw27KWZqxGxndX45xxXPMio_9PIuFbdbY-_U2pZGveNblcWZWuZsyLWgj_axoqL0
VAPID_PRIVATE_KEY=t33F5ZauIoX842fR-tBLdIg8OEcxDIs0UFdEtXDPhAI
# A contact URL or mailto: some push services require in the request -- put
# something real here (your own site or email), not the example below.
VAPID_SUBJECT=mailto:admin@example.com

# --- Port (usually set automatically by your host, e.g. Render) -------------
# PORT=3000
